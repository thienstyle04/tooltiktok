DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# false = chỉ tải Google Sheet 1 lần lúc mở tool; tạo/xuất list không sync lại nền.
# Bật true nếu muốn tự kéo Sheet định kỳ (~10 phút/lần). Nút "Làm mới" vẫn sync khi cần.
DALAT_AUTO_SYNC_SHEET=false
# true = giữ dataset đã build lúc mở tool cho cả phiên (không rebuild nền khi tạo/xuất).
DALAT_SESSION_STICKY_DATASET=true
# Máy mới: backend tự tải ảnh Drive vào data/drive-file-cache khi khởi động (chạy nền)
DALAT_AUTO_WARM_DRIVE_CACHE=true
# Số luồng tải ảnh đồng thời khi tạo cache trên máy mới (mặc định và tối đa 4).
# Mức 6 có thể khiến Google Drive giới hạn request, làm thiếu ảnh trên một số máy.
# DALAT_DRIVE_CACHE_CONCURRENCY=4
# DALAT_DRIVE_FETCH_CONCURRENCY=4
# DALAT_DRIVE_CACHE_COVER_LIMIT=120

# Cấu hình Google Sheet Đà Lạt
# DALAT_FNB_SHEET_URL=https://docs.google.com/spreadsheets/d/1-ECVLtuySSlCO5AShcJle1uP9j8XCA4l/edit
# DALAT_FNB_EXPORT_URL=https://docs.google.com/spreadsheets/d/1-ECVLtuySSlCO5AShcJle1uP9j8XCA4l/export?format=xlsx

# Cấu hình Google Sheet Phan Thiết
# PHAN_THIET_FNB_SHEET_URL=https://docs.google.com/spreadsheets/d/1l1HUVSkqVgj1udZmjtmjqZ3AeWEMgp0PI9kyBd-4CVw/edit
# PHAN_THIET_FNB_EXPORT_URL=https://docs.google.com/spreadsheets/d/1l1HUVSkqVgj1udZmjtmjqZ3AeWEMgp0PI9kyBd-4CVw/export?format=xlsx

# Cấu hình Google Sheet Green Land (dữ liệu Đà Lạt, ưu tiên hiển thị đối tác đánh dấu X)
# GREEN_LAND_FNB_SHEET_URL=https://docs.google.com/spreadsheets/d/1MfoS4Rg73vF0xbBaMb2EUG48DUINlxr8aDbq1cM_MjQ/edit
# GREEN_LAND_FNB_EXPORT_URL=https://docs.google.com/spreadsheets/d/1MfoS4Rg73vF0xbBaMb2EUG48DUINlxr8aDbq1cM_MjQ/export?format=xlsx

# Cấu hình đường dẫn ảnh (máy mới chỉ cần set nếu ảnh nằm ngoài thư mục project)
# Nếu không điền, tool tự tìm trong data/images/dalat và data/images/tiktok
# DALAT_IMAGE_DIR=data/images/dalat
# TIKTOK_REFERENCE_DIR=data/images/tiktok

# Thư viện ảnh local (nếu có): copy thư mục ảnh vào data/images/library/
# Tool sẽ tự tìm trong đó khi image-mapping.json trỏ đến path không tồn tại.

# Port (mặc định backend=3000, frontend=3001, tự đổi nếu bận)
# PORT=3000
# FRONTEND_PORT=3001
